# Copy to .env and fill in your own credentials.
# ============ QDRANT CLOUD ============
QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=3gpp_rel19
QDRANT_DISTANCE=Cosine
QDRANT_TIMEOUT=300
QDRANT_UPSERT_BATCH=128
QDRANT_PREFER_GRPC=true
QDRANT_DATATYPE=float16
QDRANT_RECONNECT_EVERY=1

# ============ OPENROUTER ============
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=3gpp-rel19-rag

# ============ OPENAI ============
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ============ EMBEDDING ============
EMBED_PROVIDER=openrouter
EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIM=1536
EMBED_BATCH_SIZE=64
EMBED_CONCURRENCY=2
EMBED_PARTS=4

# ============ CHUNKING ============
CHUNK_MAX_TOKENS=1200
CHUNK_OVERLAP=150
CHUNK_MIN_TOKENS=150
CHUNK_SKIP_PATTERN=change history

# ============ PIPELINE ============
REL19_ROOT=D:/viettel/3GPP/Rel-19
DOWNLOAD_WORKERS=8
HTTP_TIMEOUT=60
LOG_LEVEL=INFO

# ============ RAG / LLM ============
RAG_PROFILE=balanced
PLANNER_MODEL=google/gemini-2.5-flash
GRADER_MODEL=google/gemini-2.5-flash
VERIFIER_MODEL=google/gemini-2.5-flash
SYNTH_MODEL=google/gemini-2.5-pro
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
SYNTH_MAX_TOKENS=8192
LLM_TIMEOUT=120

# ============ RETRIEVAL ============
RAG_DENSE_TOP=80
RAG_SPARSE_TOP=80
RAG_DENSE_WEIGHT=0.7
RAG_SPARSE_WEIGHT=0.3
RAG_TOP_K=12
RAG_MAX_SUBQUERIES=3
RAG_MAX_REFINE=2
RAG_NEIGHBOR_WINDOW=1
RAG_MIN_SCORE=0.35
RAG_EVIDENCE_CHARS=1800
RAG_RATE_PER_MIN=10
RAG_DAILY_LIMIT=100
RAG_MAX_QUESTION_CHARS=2000
RAG_HISTORY_TURNS=5
RAG_HISTORY_CHARS=700
SPARSE_VECTOR_NAME=bm25
SPARSE_COLLECTION=3gpp_rel19_sparse
SPARSE_PARTS=4
SPARSE_UPSERT_BATCH=128
